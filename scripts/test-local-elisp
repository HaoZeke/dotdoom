#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${repo_root}"

shopt -s nullglob
test_files=(local/*-test.el local/private/*-test.el)

if [[ ${#test_files[@]} -eq 0 ]]; then
  printf 'No local ERT tests found.\n' >&2
  exit 1
fi

for test_file in "${test_files[@]}"; do
  printf '==> %s\n' "${test_file}"
  load_path=(-L local)
  case "${test_file}" in
    local/private/*)
      # Private tests require the sibling impl, not the public stub loader.
      load_path=(-L local/private -L local)
      ;;
  esac
  emacs --batch -Q "${load_path[@]}" -l "${test_file}" -f ert-run-tests-batch-and-exit
done
